// This source code is released under the MIT License: https://opensource.org/licenses/MIT
// AI Agent Lens Strategy: the AI Agent Lens indicator as a backtestable alert strategy.
// https://github.com/roan-maverick/tradingview-indicator-for-ai-agents
//
// What it does
//   Same candle breakdown, regime, confluence scores and JSON packet as the indicator, plus:
//   - Real strategy orders (entry, stop, two targets, optional breakeven and time exit),
//     so TradingView's Strategy Tester backtests the rules.
//   - A pluggable SIGNAL MODULE registry and FILTER registry. Add a new entry idea by writing
//     one condition and one registry line. See docs/STRATEGY.md, "Add your own module".
//   - Alerts for AI agents and bots: one JSON packet per bar close or per trade event
//     (schema ai-agent-lens-strategy/v1), and compact order JSON on every order fill
//     (schema ai-agent-lens-order/v1).
//
// Design rules
//   1. No repainting: signals, orders and packets use closed bars only.
//   2. Higher-timeframe and daily data use the [1] + lookahead_on pattern (no future leak).
//   3. Every value an agent needs is in the packet.
//
// Not financial advice. Backtests are not a promise of future results.

//@version=6
strategy("AI Agent Lens Strategy", shorttitle = "AI Lens Strategy", overlay = true, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 1, pyramiding = 0, calc_on_every_tick = false, process_orders_on_close = false, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 100)

// ═════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═════════════════════════════════════════════════════════════════════════════
string G_STRAT = "Strategy"
string G_MOD  = "Signal modules"
string G_FLT  = "Filters"
string G_RSK  = "Exits and risk"
string G_TRD  = "Trend and momentum"
string G_VOL  = "Volume and volatility"
string G_STR  = "Structure and levels"
string G_AGT  = "AI agent alerts"
string G_VIS  = "Display"

string tradeDir       = input.string("Long and short", "Trade direction", options = ["Long and short", "Long only", "Short only"], group = G_STRAT, display = display.none)
string sizeMode       = input.string("Risk % of equity", "Position sizing", options = ["Risk % of equity", "% of equity", "Fixed quantity"], group = G_STRAT, tooltip = "Risk % of equity: the stop distance decides the size, so a stop-out loses about this % of equity.", display = display.none)
float  riskPct        = input.float(1.0, "Risk per trade (% of equity)", minval = 0.01, maxval = 100, step = 0.1, group = G_STRAT, display = display.none)
float  equityPct      = input.float(10, "Position size (% of equity)", minval = 0.1, maxval = 100, step = 1, group = G_STRAT, display = display.none)
float  fixedQty       = input.float(1, "Fixed quantity (units)", minval = 0.000001, group = G_STRAT, display = display.none)

string combineMode    = input.string("Any", "Combine enabled modules", options = ["Any", "All", "At least N"], group = G_MOD, tooltip = "How the enabled modules vote. An entry fires on the closed bar where the vote first passes.", display = display.none)
int    minVotes       = input.int(2, "N for 'At least N'", minval = 1, group = G_MOD, display = display.none)
bool   useScore       = input.bool(true, "1. Confluence score at or above threshold", group = G_MOD, display = display.none)
int    scoreThreshold = input.int(70, "    Score threshold", minval = 50, maxval = 100, group = G_MOD, display = display.none)
bool   useBos         = input.bool(false, "2. Structure break in the slow EMA direction", group = G_MOD, display = display.none)
int    bosWithin      = input.int(3, "    Break stays valid for (bars)", minval = 1, group = G_MOD, display = display.none)
bool   useEmaCross    = input.bool(false, "3. Fast EMA above / below mid EMA", group = G_MOD, display = display.none)
bool   useRsiPull     = input.bool(false, "4. RSI pullback inside the trend", group = G_MOD, display = display.none)
float  rsiPullLong    = input.float(40, "    Long: RSI was below", group = G_MOD, display = display.none)
float  rsiPullShort   = input.float(60, "    Short: RSI was above", group = G_MOD, display = display.none)
// ADD NEW MODULE INPUTS HERE (one input.bool toggle per module, plus its own settings)

bool   fltRegime      = input.bool(true, "Block setups against the regime", group = G_FLT, tooltip = "No longs in TREND_DOWN, no shorts in TREND_UP.", display = display.none)
bool   blockHighVol   = input.bool(true, "Block setups in HIGH_VOLATILITY regime", group = G_FLT, display = display.none)
bool   fltHtf         = input.bool(false, "Require higher-timeframe agreement", group = G_FLT, tooltip = "Longs only when the HTF bias is UP, shorts only when it is DOWN.", display = display.none)
bool   fltSession     = input.bool(false, "Trade only inside a session", group = G_FLT, display = display.none)
string sessionIn      = input.session("0700-2000", "    Session (exchange time)", group = G_FLT, display = display.none)
// ADD NEW FILTER INPUTS HERE

float  stopAtr        = input.float(1.5, "Stop distance (x ATR)", minval = 0.1, step = 0.1, group = G_RSK, display = display.none)
float  t1R            = input.float(1.5, "Target 1 (R multiple)", minval = 0.1, step = 0.1, group = G_RSK, display = display.none)
float  t2R            = input.float(3.0, "Target 2 (R multiple)", minval = 0.1, step = 0.1, group = G_RSK, display = display.none)
float  t1Pct          = input.float(50, "Close at target 1 (% of position)", minval = 0, maxval = 100, step = 5, group = G_RSK, tooltip = "0 = no partial exit, the whole position aims for target 2.", display = display.none)
bool   moveBe         = input.bool(true, "Move stop to entry after target 1", group = G_RSK, display = display.none)
int    maxBarsInTrade = input.int(0, "Time exit after N bars (0 = off)", minval = 0, group = G_RSK, display = display.none)

string htfTf          = input.timeframe("240", "Higher timeframe", group = G_TRD, tooltip = "Must be higher than the chart timeframe. Otherwise the HTF factor is neutral.", display = display.none)
int    htfEmaLen      = input.int(50, "Higher timeframe EMA length", minval = 2, group = G_TRD, display = display.none)
int    emaFastLen     = input.int(20, "Fast EMA", minval = 2, group = G_TRD, display = display.none)
int    emaMidLen      = input.int(50, "Mid EMA", minval = 2, group = G_TRD, display = display.none)
int    emaSlowLen     = input.int(200, "Slow EMA", minval = 2, group = G_TRD, display = display.none)
int    slopeLen       = input.int(5, "Slow EMA slope lookback (bars)", minval = 1, group = G_TRD, display = display.none)
int    rsiLen         = input.int(14, "RSI length", minval = 2, group = G_TRD, display = display.none)
float  rsiOB          = input.float(75, "RSI overbought", group = G_TRD, display = display.none)
float  rsiOS          = input.float(25, "RSI oversold", group = G_TRD, display = display.none)
int    adxLen         = input.int(14, "ADX / DMI length", minval = 2, group = G_TRD, display = display.none)
float  adxTrend       = input.float(20, "ADX trend threshold", group = G_TRD, display = display.none)

int    volLen         = input.int(20, "Volume average length", minval = 2, group = G_VOL, display = display.none)
int    atrLen         = input.int(14, "ATR length", minval = 2, group = G_VOL, display = display.none)
int    atrPctLen      = input.int(100, "ATR percentile lookback", minval = 10, group = G_VOL, display = display.none)
float  highVolPct     = input.float(90, "HIGH_VOLATILITY when ATR percentile is at or above", minval = 50, maxval = 100, group = G_VOL, display = display.none)

int    swingLen       = input.int(5, "Swing pivot strength (bars each side)", minval = 1, group = G_STR, display = display.none)

string packetMode     = input.string("Every bar close", "Send JSON packet", options = ["Every bar close", "Trade events only", "Off"], group = G_AGT, tooltip = "Alert condition: 'alert() function calls only'. For bots, use 'Order fills only' with the message {{strategy.order.alert_message}}.", display = display.none)
int    recentCount    = input.int(5, "Recent candles in packet", minval = 1, maxval = 10, group = G_AGT, display = display.none)
string botTag         = input.string("", "Bot / account tag (optional)", group = G_AGT, tooltip = "Copied into every packet and order message as \"tag\", so one webhook can route many strategies.", display = display.none)
bool   showPreview    = input.bool(false, "Show packet preview on chart", group = G_AGT, display = display.none)

bool   showPanel      = input.bool(true, "Show Strategy Readout panel", group = G_VIS, display = display.none)
string panelPosIn     = input.string("Top right", "Panel position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = G_VIS, display = display.none)
string panelSizeIn    = input.string("Small", "Panel text size", options = ["Tiny", "Small", "Normal"], group = G_VIS, display = display.none)
bool   showMarkers    = input.bool(true, "Show signal labels", group = G_VIS, display = display.none)
bool   showLevelsOpen = input.bool(true, "Show stop and target lines of the open trade", group = G_VIS, display = display.none)
bool   showEmas       = input.bool(true, "Show EMA ribbon", group = G_VIS, display = display.none)
bool   showLevels     = input.bool(true, "Show key levels (previous day, VWAP)", group = G_VIS, display = display.none)
bool   showStructure  = input.bool(true, "Show swing points and breaks", group = G_VIS, display = display.none)

// ═════════════════════════════════════════════════════════════════════════════
// COLORS
// ═════════════════════════════════════════════════════════════════════════════
color C_BULL   = #00E676
color C_BEAR   = #FF5252
color C_NEUT   = #787B86
color C_WARN   = #FFD740
color C_CYAN   = #00E5FF
color C_PURPLE = #B388FF
color C_BG     = #0B0E14
color C_HEAD   = #161B26
color C_SECT   = #121621
color C_TEXT   = #E0E3EB

// ═════════════════════════════════════════════════════════════════════════════
// CORE CALCULATIONS
// ═════════════════════════════════════════════════════════════════════════════
float emaF = ta.ema(close, emaFastLen)
float emaM = ta.ema(close, emaMidLen)
float emaS = ta.ema(close, emaSlowLen)
float rsiV = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
[diPlus, diMinus, adxV] = ta.dmi(adxLen, adxLen)
float atrV    = ta.atr(atrLen)
float atrPct  = ta.percentrank(atrV, atrPctLen)
float volAvg  = ta.sma(volume, volLen)
float relVol  = volAvg > 0 ? volume / volAvg : na
float vwapV   = ta.vwap(hlc3)

// Previous day high and low (no lookahead leak)
float pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
float pdl = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)

// Higher-timeframe bias (no lookahead leak)
bool htfValid = timeframe.in_seconds(htfTf) > timeframe.in_seconds()
[htfClose, htfEma] = request.security(syminfo.tickerid, htfTf, [close[1], ta.ema(close, htfEmaLen)[1]], lookahead = barmerge.lookahead_on)
int htfBias = not htfValid ? 0 : htfClose > htfEma ? 1 : htfClose < htfEma ? -1 : 0
string htfBiasStr = not htfValid ? "N/A" : htfBias == 1 ? "UP" : htfBias == -1 ? "DOWN" : "FLAT"

// Trend description
string stackStr = emaF > emaM and emaM > emaS ? "BULLISH" : emaF < emaM and emaM < emaS ? "BEARISH" : "MIXED"
string slopeStr = emaS > emaS[slopeLen] ? "RISING" : emaS < emaS[slopeLen] ? "FALLING" : "FLAT"

// ═════════════════════════════════════════════════════════════════════════════
// REGIME
// ═════════════════════════════════════════════════════════════════════════════
bool trendUp   = close > emaS and emaS > emaS[slopeLen] and adxV >= adxTrend
bool trendDown = close < emaS and emaS < emaS[slopeLen] and adxV >= adxTrend
bool highVol   = atrPct >= highVolPct
string regime  = highVol ? "HIGH_VOLATILITY" : trendUp ? "TREND_UP" : trendDown ? "TREND_DOWN" : "RANGE"
int regimeCode = highVol ? 2 : trendUp ? 1 : trendDown ? -1 : 0

// ═════════════════════════════════════════════════════════════════════════════
// CONFLUENCE SCORES (0 to 100, five factors worth 20 points each)
// ═════════════════════════════════════════════════════════════════════════════
bool bullBar = close > open
bool bearBar = close < open

int lTrend = (emaF > emaM ? 7 : 0) + (emaM > emaS ? 7 : 0) + (close > emaF ? 6 : 0)
int sTrend = (emaF < emaM ? 7 : 0) + (emaM < emaS ? 7 : 0) + (close < emaF ? 6 : 0)

int lMom = (rsiV > 50 ? (rsiV >= rsiOB ? 4 : 10) : 0) + (macdHist > 0 ? 5 : 0) + (macdHist > macdHist[1] ? 5 : 0)
int sMom = (rsiV < 50 ? (rsiV <= rsiOS ? 4 : 10) : 0) + (macdHist < 0 ? 5 : 0) + (macdHist < macdHist[1] ? 5 : 0)

int lStr = (diPlus > diMinus ? 10 : 0) + (diPlus > diMinus and adxV >= adxTrend ? 10 : 0)
int sStr = (diMinus > diPlus ? 10 : 0) + (diMinus > diPlus and adxV >= adxTrend ? 10 : 0)

int lVol = bullBar and relVol >= 1.5 ? 20 : bullBar and relVol >= 1.0 ? 12 : bullBar ? 6 : 0
int sVol = bearBar and relVol >= 1.5 ? 20 : bearBar and relVol >= 1.0 ? 12 : bearBar ? 6 : 0

int lHtf = htfBias == 1 ? 20 : htfBias == 0 ? 10 : 0
int sHtf = htfBias == -1 ? 20 : htfBias == 0 ? 10 : 0

int longScore  = lTrend + lMom + lStr + lVol + lHtf
int shortScore = sTrend + sMom + sStr + sVol + sHtf

// ═════════════════════════════════════════════════════════════════════════════
// MARKET STRUCTURE (confirmed swing pivots, no repainting)
// ═════════════════════════════════════════════════════════════════════════════
float ph = ta.pivothigh(high, swingLen, swingLen)
float pl = ta.pivotlow(low, swingLen, swingLen)
var float swingH1 = na
var float swingH2 = na
var float swingL1 = na
var float swingL2 = na
if not na(ph)
    swingH2 := swingH1
    swingH1 := ph
if not na(pl)
    swingL2 := swingL1
    swingL1 := pl

string structBias = swingH1 > swingH2 and swingL1 > swingL2 ? "BULLISH" : swingH1 < swingH2 and swingL1 < swingL2 ? "BEARISH" : "MIXED"
bool breakUp   = not na(swingH1) and close > swingH1 and close[1] <= swingH1
bool breakDown = not na(swingL1) and close < swingL1 and close[1] >= swingL1
string structEvent = breakUp ? "BREAK_UP" : breakDown ? "BREAK_DOWN" : "NONE"

// ═════════════════════════════════════════════════════════════════════════════
// CANDLE ANATOMY
// ═════════════════════════════════════════════════════════════════════════════
f_num(float x, string fmt) =>
    na(x) ? "null" : str.tostring(x, fmt)

f_bool(bool b) =>
    b ? "true" : "false"

// Shape-based pattern for the current candle. Context (trend, location) is the agent's job.
f_pattern(float a) =>
    float o   = open
    float h   = high
    float l   = low
    float c   = close
    float po  = open[1]
    float pc  = close[1]
    float pH  = high[1]
    float pL  = low[1]
    float rng = h - l
    float body = math.abs(c - o)
    float up  = h - math.max(o, c)
    float dn  = math.min(o, c) - l
    string p  = "NONE"
    if rng <= 0
        p := "FLAT"
    else if c > o and pc < po and c >= po and o <= pc
        p := "BULLISH_ENGULFING"
    else if c < o and pc > po and o >= pc and c <= po
        p := "BEARISH_ENGULFING"
    else if body / rng <= 0.1
        p := "DOJI"
    else if dn >= 2 * body and up <= 0.15 * rng
        p := "HAMMER"
    else if up >= 2 * body and dn <= 0.15 * rng
        p := "SHOOTING_STAR"
    else if body / rng >= 0.9
        p := c > o ? "BULLISH_MARUBOZU" : "BEARISH_MARUBOZU"
    else if h < pH and l > pL
        p := "INSIDE_BAR"
    else if h > pH and l < pL
        p := "OUTSIDE_BAR"
    else if a > 0 and rng >= 1.8 * a
        p := c > o ? "WIDE_RANGE_BULL" : "WIDE_RANGE_BEAR"
    p

// JSON body for the current candle. Built on every bar so older candles are read from its history.
f_candleBody(string pattern) =>
    float rng = high - low
    string dir = close > open ? "bull" : close < open ? "bear" : "flat"
    string s = '"o":' + f_num(open, format.mintick)
    s += ',"h":' + f_num(high, format.mintick)
    s += ',"l":' + f_num(low, format.mintick)
    s += ',"c":' + f_num(close, format.mintick)
    s += ',"v":' + f_num(volume, "#.####")
    s += ',"dir":"' + dir + '"'
    s += ',"body_pct":' + f_num(rng > 0 ? math.abs(close - open) / rng * 100 : 0.0, "#.#")
    s += ',"range_atr":' + f_num(atrV > 0 ? rng / atrV : na, "#.##")
    s += ',"pattern":"' + pattern + '"'
    s

float cRng      = high - low
float cBody     = math.abs(close - open)
float cBodyPct  = cRng > 0 ? cBody / cRng * 100 : 0.0
float cUpPct    = cRng > 0 ? (high - math.max(open, close)) / cRng * 100 : 0.0
float cDnPct    = cRng > 0 ? (math.min(open, close) - low) / cRng * 100 : 0.0
float cRangeAtr = atrV > 0 ? cRng / atrV : na
float cClosePos = cRng > 0 ? (close - low) / cRng * 100 : 50.0
float cGapPct   = close[1] > 0 ? (open - close[1]) / close[1] * 100 : na
string cDir     = bullBar ? "bull" : bearBar ? "bear" : "flat"
string cPattern = f_pattern(atrV)
string candleBody = f_candleBody(cPattern)
max_bars_back(candleBody, 12)

// ═════════════════════════════════════════════════════════════════════════════
// EXTENSION POINTS: SIGNAL MODULES AND FILTERS
// ═════════════════════════════════════════════════════════════════════════════
// A SIGNAL MODULE is one entry idea. On every bar it reports a STATE:
//   longCond  = this module agrees with a long right now
//   shortCond = this module agrees with a short right now
// The enabled modules vote (Any / All / At least N). An entry fires on the closed bar where
// the vote FIRST passes, so a state that lasts many bars gives one entry, not many.
//
// A FILTER can only block. allowLong / allowShort = false stops that side from entering.
//
// To add your own module (full guide in docs/STRATEGY.md):
//   1. Add an input.bool toggle under "ADD NEW MODULE INPUTS HERE".
//   2. Compute two bools, myLong and myShort, under "ADD NEW MODULE CONDITIONS HERE".
//   3. Register it under "ADD NEW MODULES HERE":
//        modules.push(SignalModule.new("my_module", useMyModule, myLong, myShort))
// Nothing else changes: votes, orders, alerts, the JSON packet and the panel pick it up.
type SignalModule
    string name
    bool   enabled
    bool   longCond
    bool   shortCond

type FilterModule
    string name
    bool   enabled
    bool   allowLong
    bool   allowShort

// Module 2: a structure break in the direction of the slow EMA, valid for a few bars
int  barsSinceBreakUp   = ta.barssince(breakUp)
int  barsSinceBreakDown = ta.barssince(breakDown)
bool bosLong  = not na(barsSinceBreakUp) and barsSinceBreakUp < bosWithin and close > emaS
bool bosShort = not na(barsSinceBreakDown) and barsSinceBreakDown < bosWithin and close < emaS

// Module 4: RSI dipped in an uptrend and recovered above 50 (mirror for shorts)
float rsiLow5  = ta.lowest(rsiV, 5)
float rsiHigh5 = ta.highest(rsiV, 5)
bool rsiPullL = close > emaS and emaF > emaM and rsiV > 50 and rsiLow5[1] < rsiPullLong
bool rsiPullS = close < emaS and emaF < emaM and rsiV < 50 and rsiHigh5[1] > rsiPullShort

// ADD NEW MODULE CONDITIONS HERE
//   bool myLong  = ...
//   bool myShort = ...

array<SignalModule> modules = array.new<SignalModule>()
modules.push(SignalModule.new("confluence_score", useScore, longScore >= scoreThreshold, shortScore >= scoreThreshold))
modules.push(SignalModule.new("structure_break", useBos, bosLong, bosShort))
modules.push(SignalModule.new("ema_cross", useEmaCross, emaF > emaM, emaF < emaM))
modules.push(SignalModule.new("rsi_pullback", useRsiPull, rsiPullL, rsiPullS))
// ADD NEW MODULES HERE

bool inSession = not na(time(timeframe.period, sessionIn))

array<FilterModule> filters = array.new<FilterModule>()
filters.push(FilterModule.new("direction", true, tradeDir != "Short only", tradeDir != "Long only"))
filters.push(FilterModule.new("regime", fltRegime, regime != "TREND_DOWN", regime != "TREND_UP"))
filters.push(FilterModule.new("high_volatility", blockHighVol, regime != "HIGH_VOLATILITY", regime != "HIGH_VOLATILITY"))
filters.push(FilterModule.new("htf_agreement", fltHtf, htfBias == 1, htfBias == -1))
filters.push(FilterModule.new("session", fltSession, inSession, inSession))
// ADD NEW FILTERS HERE

// ═════════════════════════════════════════════════════════════════════════════
// COMBINER (do not edit for new modules)
// ═════════════════════════════════════════════════════════════════════════════
int modEnabled = 0
int longVotes  = 0
int shortVotes = 0
for m in modules
    if m.enabled
        modEnabled += 1
        longVotes  += m.longCond ? 1 : 0
        shortVotes += m.shortCond ? 1 : 0

// "At least N" is capped at the number of enabled modules, so it never silently stops trading
int votesNeeded = combineMode == "All" ? modEnabled : combineMode == "At least N" ? math.min(minVotes, modEnabled) : 1
bool longComb  = modEnabled > 0 and longVotes >= votesNeeded
bool shortComb = modEnabled > 0 and shortVotes >= votesNeeded

bool filtLongOk  = true
bool filtShortOk = true
for f in filters
    if f.enabled
        filtLongOk  := filtLongOk and f.allowLong
        filtShortOk := filtShortOk and f.allowShort

bool longEdge  = longComb and not longComb[1]
bool shortEdge = shortComb and not shortComb[1]
bool longCond  = longEdge and filtLongOk
bool shortCond = shortEdge and filtShortOk
bool longSig   = longCond and not shortCond and barstate.isconfirmed
bool shortSig  = shortCond and not longCond and barstate.isconfirmed

// ═════════════════════════════════════════════════════════════════════════════
// ORDERS, FILLS AND TRADE STATE (closed bars only)
// ═════════════════════════════════════════════════════════════════════════════
f_sep(string s) =>
    str.length(s) > 0 ? "," : ""

f_tagJson() =>
    str.length(botTag) > 0 ? ',"tag":"' + botTag + '"' : ""

f_qty(float riskPerUnit) =>
    float pv = syminfo.pointvalue
    float q = switch sizeMode
        "Risk % of equity" => riskPerUnit > 0 ? strategy.equity * riskPct / 100 / (riskPerUnit * pv) : na
        "% of equity"      => close > 0 ? strategy.equity * equityPct / 100 / (close * pv) : na
        => fixedQty
    q

// Compact order message for bots. Sent on order fills when the alert message is
// {{strategy.order.alert_message}}. Schema: ai-agent-lens-order/v1 (docs/PACKET_SCHEMA.md).
f_orderMsg(string action, string orderId, string reason, float qty, float stopP, float t1P, float t2P) =>
    string fp = format.mintick
    string m = '{"schema":"ai-agent-lens-order/v1"' + f_tagJson()
    m += ',"action":"' + action + '","reason":"' + reason + '","order_id":"' + orderId + '"'
    m += ',"symbol":"' + syminfo.prefix + ":" + syminfo.ticker + '","timeframe":"' + timeframe.period + '"'
    m += ',"time":"' + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '"'
    m += ',"price_ref":' + f_num(close, fp) + ',"qty":' + f_num(qty, "#.########")
    m += ',"stop":' + f_num(stopP, fp) + ',"target_1":' + f_num(t1P, fp) + ',"target_2":' + f_num(t2P, fp) + '}'
    m

// The exit comment tells why a trade (or part of it) closed
f_reason(string c) =>
    c == "T1" or c == "T2" or c == "SL" or c == "BE" or c == "TIME" ? c : "REVERSE"

f_closeStatus(string reason, bool afterT1) =>
    switch reason
        "T1"   => "TARGET_1_HIT"
        "T2"   => "TARGET_2_HIT"
        "SL"   => afterT1 ? "STOPPED_AFTER_T1" : "STOPPED"
        "BE"   => "BREAKEVEN_AFTER_T1"
        "TIME" => "TIME_EXIT"
        => "REVERSED"

float posNow  = strategy.position_size
float posPrev = nz(strategy.position_size[1])

var int    pSide       = 0
var float  pEntry      = na
var float  pStop       = na
var float  pT1         = na
var float  pT2         = na
var float  pQty        = na
var float  curStop     = na
var int    lastSigBar  = na
var string lastSigSide = "NONE"
var string tStatus     = "NONE"
var bool   t1Done      = false
var int    seenClosed  = 0

string fills      = ""
bool openedLong   = false
bool openedShort  = false
bool evEntryFill  = false
bool evPartial    = false
bool evExit       = false

if barstate.isconfirmed
    string fp = format.mintick
    // 1) Closed trades since the previous bar. A partial exit counts as one closed trade.
    int nClosed = strategy.closedtrades
    bool t1HitNow = false
    if nClosed > seenClosed
        for i = seenClosed to nClosed - 1
            string reason = f_reason(strategy.closedtrades.exit_comment(i))
            float  sz     = strategy.closedtrades.size(i)
            bool isPartial = reason == "T1" and posNow != 0 and math.sign(posNow) == math.sign(sz)
            if isPartial
                evPartial := true
                t1Done := true
                t1HitNow := true
                tStatus := "TARGET_1_HIT"
            else
                evExit := true
                tStatus := f_closeStatus(reason, t1Done)
            fills += f_sep(fills) + '{"type":"' + (isPartial ? "PARTIAL_EXIT" : "EXIT") + '","side":"' + (sz > 0 ? "LONG" : "SHORT") + '","reason":"' + reason + '"'
            fills += ',"entry_price":' + f_num(strategy.closedtrades.entry_price(i), fp) + ',"exit_price":' + f_num(strategy.closedtrades.exit_price(i), fp)
            fills += ',"qty":' + f_num(math.abs(sz), "#.########") + ',"profit":' + f_num(strategy.closedtrades.profit(i), "#.##") + '}'
        seenClosed := nClosed

    // 2) A new position was filled this bar (also after a reversal)
    if posNow != 0 and (posPrev == 0 or math.sign(posNow) != math.sign(posPrev))
        evEntryFill := true
        t1Done := false
        tStatus := "ACTIVE"
        fills += f_sep(fills) + '{"type":"ENTRY","side":"' + (posNow > 0 ? "LONG" : "SHORT") + '","price":' + f_num(strategy.position_avg_price, fp) + ',"qty":' + f_num(math.abs(posNow), "#.########") + '}'

    // 3) Breakeven after target 1
    if t1HitNow and moveBe and posNow != 0
        curStop := strategy.position_avg_price
        if posNow > 0
            strategy.exit("Long T2", "Long", limit = pT2, stop = curStop, comment_profit = "T2", comment_loss = "BE", alert_profit = f_orderMsg("CLOSE_LONG", "Long T2", "T2", math.abs(posNow), curStop, pT1, pT2), alert_loss = f_orderMsg("CLOSE_LONG", "Long T2", "BE", math.abs(posNow), curStop, pT1, pT2))
        else
            strategy.exit("Short T2", "Short", limit = pT2, stop = curStop, comment_profit = "T2", comment_loss = "BE", alert_profit = f_orderMsg("CLOSE_SHORT", "Short T2", "T2", math.abs(posNow), curStop, pT1, pT2), alert_loss = f_orderMsg("CLOSE_SHORT", "Short T2", "BE", math.abs(posNow), curStop, pT1, pT2))

    // 4) Time exit
    if maxBarsInTrade > 0 and posNow != 0 and strategy.opentrades > 0
        if bar_index - strategy.opentrades.entry_bar_index(0) >= maxBarsInTrade
            strategy.close_all(comment = "TIME", alert_message = f_orderMsg(posNow > 0 ? "CLOSE_LONG" : "CLOSE_SHORT", "ALL", "TIME", math.abs(posNow), curStop, pT1, pT2))

    // 5) New signals. Same direction as the open position is ignored; the opposite side reverses.
    if longSig and posNow <= 0
        float stopL = close - stopAtr * atrV
        float riskL = close - stopL
        float qL = f_qty(riskL)
        if riskL > 0 and qL > 0
            openedLong := true
            pSide := 1
            pEntry := close
            pStop := stopL
            curStop := stopL
            pT1 := close + t1R * riskL
            pT2 := close + t2R * riskL
            pQty := qL
            lastSigBar := bar_index
            lastSigSide := "LONG"
            tStatus := "PENDING"
            strategy.cancel("Short T1")
            strategy.cancel("Short T2")
            strategy.entry("Long", strategy.long, qty = qL, comment = "Long", alert_message = f_orderMsg("OPEN_LONG", "Long", "SIGNAL", qL, pStop, pT1, pT2))
            if t1Pct > 0
                strategy.exit("Long T1", "Long", qty_percent = t1Pct, limit = pT1, stop = pStop, comment_profit = "T1", comment_loss = "SL", alert_profit = f_orderMsg("CLOSE_LONG", "Long T1", "T1", qL * t1Pct / 100, pStop, pT1, pT2), alert_loss = f_orderMsg("CLOSE_LONG", "Long T1", "SL", qL * t1Pct / 100, pStop, pT1, pT2))
            strategy.exit("Long T2", "Long", limit = pT2, stop = pStop, comment_profit = "T2", comment_loss = "SL", alert_profit = f_orderMsg("CLOSE_LONG", "Long T2", "T2", qL * (100 - t1Pct) / 100, pStop, pT1, pT2), alert_loss = f_orderMsg("CLOSE_LONG", "Long T2", "SL", qL * (100 - t1Pct) / 100, pStop, pT1, pT2))
    else if shortSig and posNow >= 0
        float stopS = close + stopAtr * atrV
        float riskS = stopS - close
        float qS = f_qty(riskS)
        if riskS > 0 and qS > 0
            openedShort := true
            pSide := -1
            pEntry := close
            pStop := stopS
            curStop := stopS
            pT1 := close - t1R * riskS
            pT2 := close - t2R * riskS
            pQty := qS
            lastSigBar := bar_index
            lastSigSide := "SHORT"
            tStatus := "PENDING"
            strategy.cancel("Long T1")
            strategy.cancel("Long T2")
            strategy.entry("Short", strategy.short, qty = qS, comment = "Short", alert_message = f_orderMsg("OPEN_SHORT", "Short", "SIGNAL", qS, pStop, pT1, pT2))
            if t1Pct > 0
                strategy.exit("Short T1", "Short", qty_percent = t1Pct, limit = pT1, stop = pStop, comment_profit = "T1", comment_loss = "SL", alert_profit = f_orderMsg("CLOSE_SHORT", "Short T1", "T1", qS * t1Pct / 100, pStop, pT1, pT2), alert_loss = f_orderMsg("CLOSE_SHORT", "Short T1", "SL", qS * t1Pct / 100, pStop, pT1, pT2))
            strategy.exit("Short T2", "Short", limit = pT2, stop = pStop, comment_profit = "T2", comment_loss = "SL", alert_profit = f_orderMsg("CLOSE_SHORT", "Short T2", "T2", qS * (100 - t1Pct) / 100, pStop, pT1, pT2), alert_loss = f_orderMsg("CLOSE_SHORT", "Short T2", "SL", qS * (100 - t1Pct) / 100, pStop, pT1, pT2))

string eventStr = openedLong ? "LONG_ENTRY" : openedShort ? "SHORT_ENTRY" : evExit ? "EXIT" : evPartial ? "PARTIAL_EXIT" : evEntryFill ? "ENTRY_FILLED" : "BAR_CLOSE"
string sideStr  = posNow > 0 ? "LONG" : posNow < 0 ? "SHORT" : "FLAT"
string stateCode = "LENS-S|" + syminfo.ticker + "|" + timeframe.period + "|" + regime + "|L" + str.tostring(longScore) + "|S" + str.tostring(shortScore) + "|V" + str.tostring(longVotes) + "/" + str.tostring(shortVotes) + "|" + sideStr + ":" + tStatus

// ═════════════════════════════════════════════════════════════════════════════
// JSON PACKET (schema: ai-agent-lens-strategy/v1, see docs/PACKET_SCHEMA.md)
// ═════════════════════════════════════════════════════════════════════════════
f_modulesJson() =>
    string s = "["
    int k = 0
    for m in modules
        s += (k > 0 ? "," : "") + '{"name":"' + m.name + '","enabled":' + f_bool(m.enabled) + ',"long":' + f_bool(m.longCond) + ',"short":' + f_bool(m.shortCond) + '}'
        k += 1
    s + "]"

f_filtersJson() =>
    string s = "["
    int k = 0
    for f in filters
        s += (k > 0 ? "," : "") + '{"name":"' + f.name + '","enabled":' + f_bool(f.enabled) + ',"allow_long":' + f_bool(f.allowLong) + ',"allow_short":' + f_bool(f.allowShort) + '}'
        k += 1
    s + "]"

f_packet() =>
    string fp = format.mintick
    string t  = str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
    string pk = '{"schema":"ai-agent-lens-strategy/v1"' + f_tagJson()
    pk += ',"event":"' + eventStr + '"'
    pk += ',"symbol":"' + syminfo.prefix + ":" + syminfo.ticker + '"'
    pk += ',"timeframe":"' + timeframe.period + '"'
    pk += ',"time":"' + t + '"'
    pk += ',"state_code":"' + stateCode + '"'
    // Candle breakdown (same fields as the indicator packet)
    pk += ',"candle":{"open":' + f_num(open, fp) + ',"high":' + f_num(high, fp) + ',"low":' + f_num(low, fp) + ',"close":' + f_num(close, fp)
    pk += ',"volume":' + f_num(volume, "#.####") + ',"direction":"' + cDir + '"'
    pk += ',"body_pct":' + f_num(cBodyPct, "#.#") + ',"upper_wick_pct":' + f_num(cUpPct, "#.#") + ',"lower_wick_pct":' + f_num(cDnPct, "#.#")
    pk += ',"range_atr":' + f_num(cRangeAtr, "#.##") + ',"close_position_pct":' + f_num(cClosePos, "#.#") + ',"gap_pct":' + f_num(cGapPct, "#.###")
    pk += ',"closed_above_prev_high":' + f_bool(close > high[1]) + ',"closed_below_prev_low":' + f_bool(close < low[1])
    pk += ',"pattern":"' + cPattern + '"}'
    string rc = "["
    for k = recentCount - 1 to 0
        rc += '{"bars_ago":' + str.tostring(k) + "," + candleBody[k] + "}" + (k > 0 ? "," : "")
    pk += ',"recent_candles":' + rc + "]"
    // Context
    pk += ',"regime":"' + regime + '"'
    pk += ',"trend":{"ema_fast":' + f_num(emaF, fp) + ',"ema_mid":' + f_num(emaM, fp) + ',"ema_slow":' + f_num(emaS, fp)
    pk += ',"stack":"' + stackStr + '","slow_slope":"' + slopeStr + '","htf":"' + htfTf + '","htf_bias":"' + htfBiasStr + '"}'
    pk += ',"momentum":{"rsi":' + f_num(rsiV, "#.##") + ',"macd_hist":' + f_num(macdHist, "#.######") + ',"macd_hist_rising":' + f_bool(macdHist > macdHist[1]) + '}'
    pk += ',"strength":{"adx":' + f_num(adxV, "#.##") + ',"di_plus":' + f_num(diPlus, "#.##") + ',"di_minus":' + f_num(diMinus, "#.##") + '}'
    pk += ',"volatility":{"atr":' + f_num(atrV, fp) + ',"atr_percentile":' + f_num(atrPct, "#.#") + '}'
    pk += ',"volume":{"relative":' + f_num(relVol, "#.##") + '}'
    pk += ',"structure":{"bias":"' + structBias + '","event":"' + structEvent + '","last_swing_high":' + f_num(swingH1, fp) + ',"last_swing_low":' + f_num(swingL1, fp) + '}'
    pk += ',"levels":{"prev_day_high":' + f_num(pdh, fp) + ',"prev_day_low":' + f_num(pdl, fp) + ',"vwap":' + f_num(vwapV, fp) + '}'
    pk += ',"scores":{"long":' + str.tostring(longScore) + ',"short":' + str.tostring(shortScore) + ',"threshold":' + str.tostring(scoreThreshold)
    pk += ',"long_factors":{"trend":' + str.tostring(lTrend) + ',"momentum":' + str.tostring(lMom) + ',"strength":' + str.tostring(lStr) + ',"volume":' + str.tostring(lVol) + ',"htf":' + str.tostring(lHtf) + '}'
    pk += ',"short_factors":{"trend":' + str.tostring(sTrend) + ',"momentum":' + str.tostring(sMom) + ',"strength":' + str.tostring(sStr) + ',"volume":' + str.tostring(sVol) + ',"htf":' + str.tostring(sHtf) + '}}'
    // Strategy extensions
    pk += ',"signals":{"combine":"' + combineMode + '","enabled":' + str.tostring(modEnabled) + ',"votes_needed":' + str.tostring(votesNeeded)
    pk += ',"long_votes":' + str.tostring(longVotes) + ',"short_votes":' + str.tostring(shortVotes) + ',"modules":' + f_modulesJson() + '}'
    pk += ',"filters":{"long_ok":' + f_bool(filtLongOk) + ',"short_ok":' + f_bool(filtShortOk) + ',"items":' + f_filtersJson() + '}'
    pk += ',"trade":{"side":"' + sideStr + '","status":"' + tStatus + '","entry":' + f_num(posNow != 0 ? strategy.position_avg_price : pEntry, fp) + ',"stop":' + f_num(curStop, fp)
    pk += ',"target_1":' + f_num(pT1, fp) + ',"target_2":' + f_num(pT2, fp) + ',"qty":' + f_num(math.abs(posNow), "#.########")
    pk += ',"bars_since_entry":' + (posNow != 0 and strategy.opentrades > 0 ? str.tostring(bar_index - strategy.opentrades.entry_bar_index(0)) : "null") + '}'
    pk += ',"last_setup":{"side":"' + lastSigSide + '","bars_ago":' + (na(lastSigBar) ? "null" : str.tostring(bar_index - lastSigBar)) + '}'
    pk += ',"fills":[' + fills + ']'
    float winRate = strategy.closedtrades > 0 ? float(strategy.wintrades) / strategy.closedtrades * 100 : na
    pk += ',"performance":{"equity":' + f_num(strategy.equity, "#.##") + ',"net_profit":' + f_num(strategy.netprofit, "#.##") + ',"open_profit":' + f_num(strategy.openprofit, "#.##")
    pk += ',"closed_trades":' + str.tostring(strategy.closedtrades) + ',"win_rate_pct":' + f_num(winRate, "#.#") + ',"max_drawdown":' + f_num(strategy.max_drawdown, "#.##") + '}'
    pk += '}'
    pk

bool wantPacket = packetMode == "Every bar close" or (packetMode == "Trade events only" and eventStr != "BAR_CLOSE")
if barstate.islast and barstate.isconfirmed and (wantPacket or showPreview)
    string packet = f_packet()
    if wantPacket
        alert(packet, alert.freq_once_per_bar_close)
    if showPreview
        var label prev = na
        label.delete(prev)
        prev := label.new(bar_index + 14, close, packet, style = label.style_label_left, color = color.new(C_HEAD, 0), textcolor = C_TEXT, size = size.tiny, textalign = text.align_left)

// ═════════════════════════════════════════════════════════════════════════════
// VISUALS
// ═════════════════════════════════════════════════════════════════════════════
pFast = plot(showEmas ? emaF : na, "EMA fast", color = color.new(C_CYAN, 10), linewidth = 1, display = display.pane)
pMid  = plot(showEmas ? emaM : na, "EMA mid", color = color.new(C_WARN, 10), linewidth = 1, display = display.pane)
fill(pFast, pMid, color = emaF > emaM ? color.new(C_BULL, 82) : color.new(C_BEAR, 82), title = "EMA ribbon")
plot(showEmas ? emaS : na, "EMA slow", color = color.new(C_PURPLE, 0), linewidth = 2, display = display.pane)

plot(showLevels ? pdh : na, "Prev day high", color = color.new(C_NEUT, 20), style = plot.style_circles, linewidth = 1, display = display.pane)
plot(showLevels ? pdl : na, "Prev day low", color = color.new(C_NEUT, 20), style = plot.style_circles, linewidth = 1, display = display.pane)
plot(showLevels ? vwapV : na, "VWAP", color = color.new(#FFFFFF, 55), linewidth = 1, display = display.pane)

plotshape(showStructure and not na(ph) ? ph : na, "Swing high", shape.circle, location.absolute, color.new(C_BEAR, 30), offset = -swingLen, size = size.tiny, display = display.pane)
plotshape(showStructure and not na(pl) ? pl : na, "Swing low", shape.circle, location.absolute, color.new(C_BULL, 30), offset = -swingLen, size = size.tiny, display = display.pane)
plotshape(showStructure and breakUp and barstate.isconfirmed, "Break up", shape.triangleup, location.belowbar, color.new(C_BULL, 35), size = size.tiny, text = "BOS", textcolor = color.new(C_BULL, 35), display = display.pane)
plotshape(showStructure and breakDown and barstate.isconfirmed, "Break down", shape.triangledown, location.abovebar, color.new(C_BEAR, 35), size = size.tiny, text = "BOS", textcolor = color.new(C_BEAR, 35), display = display.pane)

bool tradeOpen = posNow != 0
plot(showLevelsOpen and tradeOpen ? curStop : na, "Open trade stop", color = color.new(C_BEAR, 10), style = plot.style_linebr, linewidth = 1, display = display.pane)
plot(showLevelsOpen and tradeOpen ? pT1 : na, "Open trade target 1", color = color.new(C_BULL, 40), style = plot.style_linebr, linewidth = 1, display = display.pane)
plot(showLevelsOpen and tradeOpen ? pT2 : na, "Open trade target 2", color = color.new(C_BULL, 10), style = plot.style_linebr, linewidth = 1, display = display.pane)

f_voteTip() =>
    string s = "Votes long " + str.tostring(longVotes) + " / short " + str.tostring(shortVotes) + " (need " + str.tostring(votesNeeded) + ")"
    for m in modules
        if m.enabled
            s += "\n" + m.name + ": " + (m.longCond ? "long" : m.shortCond ? "short" : "-")
    s + "\nRegime " + regime

if showMarkers and openedLong
    label.new(bar_index, low, "▲ LONG " + str.tostring(longVotes) + "/" + str.tostring(modEnabled), yloc = yloc.belowbar, style = label.style_label_up, color = C_BULL, textcolor = #0B0E14, size = size.small, tooltip = f_voteTip())
if showMarkers and openedShort
    label.new(bar_index, high, "▼ SHORT " + str.tostring(shortVotes) + "/" + str.tostring(modEnabled), yloc = yloc.abovebar, style = label.style_label_down, color = C_BEAR, textcolor = color.white, size = size.small, tooltip = f_voteTip())

// Data Window
plot(longScore, "Long score", color = C_BULL, display = display.data_window)
plot(shortScore, "Short score", color = C_BEAR, display = display.data_window)
plot(longVotes, "Long votes", display = display.data_window)
plot(shortVotes, "Short votes", display = display.data_window)
plot(regimeCode, "Regime code (1 up, -1 down, 0 range, 2 high vol)", display = display.data_window)
plot(htfBias, "HTF bias (1 up, -1 down, 0 flat)", display = display.data_window)
plot(math.sign(posNow), "Position (1 long, -1 short, 0 flat)", display = display.data_window)

// ═════════════════════════════════════════════════════════════════════════════
// STRATEGY READOUT PANEL
// ═════════════════════════════════════════════════════════════════════════════
f_pos(string p) =>
    switch p
        "Top left"     => position.top_left
        "Bottom right" => position.bottom_right
        "Bottom left"  => position.bottom_left
        "Middle right" => position.middle_right
        => position.top_right

f_size(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Normal" => size.normal
        => size.small

// "TREND_UP" -> "Trend up"
f_title(string s) =>
    string t = str.lower(str.replace_all(s, "_", " "))
    str.length(t) > 0 ? str.upper(str.substring(t, 0, 1)) + str.substring(t, 1) : t

color P_BG  = #0E1117
color P_KEY = #8B93A7
color P_VAL = #E6E9EF

string PANEL_SIZE = f_size(panelSizeIn)
string HERO_SIZE  = panelSizeIn == "Tiny" ? size.normal : size.large
int    PANEL_ROWS = 15
var table panel = table.new(f_pos(panelPosIn), 2, PANEL_ROWS, bgcolor = P_BG, frame_color = #232A3A, frame_width = 1, border_color = #1C2230, border_width = 1)

f_cell(int c, int r, string txt, color tc, color bg, string sz, string halign) =>
    table.cell(panel, c, r, txt, text_color = tc, bgcolor = bg, text_halign = halign, text_size = sz)

f_row(int r, string k, string v, color vc) =>
    f_cell(0, r, k, P_KEY, P_BG, PANEL_SIZE, text.align_left)
    f_cell(1, r, v, vc, P_BG, PANEL_SIZE, text.align_right)

f_wide(int r, string txt, color tc, color bg, string sz) =>
    f_cell(0, r, txt, tc, bg, sz, text.align_center)
    table.merge_cells(panel, 0, r, 1, r)

if showPanel and barstate.islast
    table.clear(panel, 0, 0, 1, PANEL_ROWS - 1)
    string fp = format.mintick
    string hero = posNow > 0 ? "LONG" : posNow < 0 ? "SHORT" : tStatus == "PENDING" ? "PENDING " + lastSigSide : "FLAT"
    color heroBg = posNow > 0 ? C_BULL : posNow < 0 ? C_BEAR : #1A1F2B
    color heroTc = posNow > 0 ? #06140C : posNow < 0 ? color.white : P_VAL
    color regimeCol = regime == "TREND_UP" ? C_BULL : regime == "TREND_DOWN" ? C_BEAR : regime == "HIGH_VOLATILITY" ? C_WARN : P_VAL

    int r = 0
    f_cell(0, r, "AI LENS STRATEGY", C_CYAN, P_BG, size.tiny, text.align_left)
    f_cell(1, r, syminfo.ticker + "  ·  " + timeframe.period, P_KEY, P_BG, size.tiny, text.align_right)
    r += 1
    f_wide(r, hero, heroTc, heroBg, HERO_SIZE)
    r += 1
    f_wide(r, tStatus == "NONE" ? "No trade yet" : f_title(tStatus), P_KEY, P_BG, PANEL_SIZE)
    r += 1
    f_row(r, "Regime", f_title(regime), regimeCol)
    r += 1
    f_row(r, "Score L / S", str.tostring(longScore) + "  /  " + str.tostring(shortScore), longScore > shortScore ? C_BULL : shortScore > longScore ? C_BEAR : P_VAL)
    r += 1
    f_row(r, "Votes L / S", str.tostring(longVotes) + " / " + str.tostring(shortVotes) + "  of " + str.tostring(modEnabled) + " (need " + str.tostring(votesNeeded) + ")", longVotes >= votesNeeded and modEnabled > 0 ? C_BULL : shortVotes >= votesNeeded and modEnabled > 0 ? C_BEAR : P_VAL)
    r += 1
    f_row(r, "Filters", "Long " + (filtLongOk ? "ok" : "blocked") + " · Short " + (filtShortOk ? "ok" : "blocked"), P_VAL)
    r += 1
    if posNow != 0
        float avgP = strategy.position_avg_price
        float riskU = math.abs(avgP - pStop)
        float rNow = riskU > 0 ? (posNow > 0 ? close - avgP : avgP - close) / riskU : na
        f_row(r, "Entry", f_num(avgP, fp), P_VAL)
        r += 1
        f_row(r, "Stop", f_num(curStop, fp), C_BEAR)
        r += 1
        f_row(r, "Targets", f_num(pT1, fp) + "  /  " + f_num(pT2, fp), C_BULL)
        r += 1
        f_row(r, "Open P&L", na(rNow) ? "n/a" : (rNow >= 0 ? "+" : "") + str.tostring(rNow, "0.00") + "R", na(rNow) ? P_KEY : rNow >= 0 ? C_BULL : C_BEAR)
        r += 1
    float wr = strategy.closedtrades > 0 ? float(strategy.wintrades) / strategy.closedtrades * 100 : na
    f_row(r, "Net profit", str.tostring(strategy.netprofit, "#.##") + " " + strategy.account_currency, strategy.netprofit >= 0 ? C_BULL : C_BEAR)
    r += 1
    f_row(r, "Closed / win rate", str.tostring(strategy.closedtrades) + "  ·  " + (na(wr) ? "n/a" : str.tostring(wr, "#.#") + "%"), P_VAL)
    r += 1
    f_row(r, "Max drawdown", str.tostring(strategy.max_drawdown, "#.##"), C_WARN)
